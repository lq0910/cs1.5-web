{
  "name": "cs15-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based Counter-Strike 1.5 style FPS (GoldSrc-faithful movement + BSP maps)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "list-maps": "node tools/list-maps.mjs",
    "make-bsp": "node tools/make-bsp.mjs",
    "extract-assets": "node tools/extract-assets.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
